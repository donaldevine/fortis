# Copy to android/keystore.properties (git-ignored) to sign release builds.
# Generate the upload keystore once:
#   keytool -genkeypair -v -keystore fortis-upload.jks -alias fortis \
#     -keyalg RSA -keysize 4096 -validity 10000
# Then enrol it as the upload key in Play Console (Play App Signing manages the
# real app-signing key). Keep the .jks and this file out of git and backed up.

storeFile=../fortis-upload.jks
storePassword=CHANGE_ME
keyAlias=fortis
keyPassword=CHANGE_ME
