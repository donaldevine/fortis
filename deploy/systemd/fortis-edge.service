# /etc/systemd/system/fortis-edge.service

[Unit]
Description=fortis-edge (public wallet backend)
After=network-online.target fortis-index.service
Wants=network-online.target

[Service]
Type=simple
User=fortis
Group=fortis
ExecStart=/usr/local/bin/fortis-edge \
  --bind 127.0.0.1:8098 \
  --btcb2-upstream http://127.0.0.1:8094 \
  --btc-upstream https://mempool.space/api \
  --btc-price-url 'https://api.kraken.com/0/public/Ticker?pair=XBTUSD' \
  --btcb2-price-url https://mempool.kilombino.com/api/v1/prices \
  --btc-upstream-rate 5 \
  --secret-file /var/lib/fortis/fortis-edge.secret \
  --require-token \
  --trust-forwarded-for \
  --allow-origin https://wallet.fortis.example \
  --crash-log /var/log/fortis/crashes.ndjson \
  --service-fee-address bc1qYOUR_FEE_ADDRESS_HERE
  # --service-fee-bps 100 (1%) and --service-fee-floor-sat 546 are the defaults.
  # --btc-upstream-rate 5 (also the default) paces /btc/address/* so a wallet's
  # ~40-address scan doesn't get 429'd by mempool.space; raise it if the upstream
  # tolerates more, 0 to disable.
Restart=on-failure
RestartSec=5
StateDirectory=fortis
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/fortis

[Install]
WantedBy=multi-user.target
